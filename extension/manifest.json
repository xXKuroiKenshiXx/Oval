{
  "manifest_version": 3,
  "name": "Oval",
  "short_name": "Oval",
  "version": "0.5.1",
  "description": "Descarga vídeos, clips, transcripciones y miniaturas con Oval desde cualquier página.",
  "homepage_url": "https://github.com/xXKuroiKenshiXx/Oval",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Oval",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": [
    "http://127.0.0.1:17177/*",
    "http://127.0.0.1:27177/*",
    "http://127.0.0.1:37177/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Abrir o cerrar el panel de Oval"
    }
  }
}
