{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oval",
  "version": "0.5.0",
  "identifier": "io.github.xxkuroikenshixx.oval",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Oval",
        "width": 700,
        "height": 700,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "dragDropEnabled": false,
        "minWidth": 460,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "publisher": "xXKuroiKenshiXx",
    "category": "Utility",
    "shortDescription": "Minimal oval video downloader",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "13.0",
      "frameworks": ["AVFoundation", "JavaScriptCore"]
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
